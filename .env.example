# KnowHub configuration: the single source for app + GCP settings.
# ./scripts/bootstrap.sh copies this to .env on first run (and fills in JWT_SECRET and
# the Ollama location). Values below are for local docker compose; container hostnames
# (postgres, gcs, pubsub, api) are used because services talk to each other inside compose.
# On GCP the same keys are set from Secret Manager / Cloud Run env.
# Keep comments on their own lines (inline comments break some docker compose versions).

# ================================================================ app
# local | dev | stage | prod
APP_ENV=local

# INFO  one line per request, plus decisions worth knowing about (why a 401 happened,
#       failed logins, uploads starting and finishing, AI calls and their latency)
# DEBUG adds query strings, storage operations, and the reason a token was rejected
LOG_LEVEL=DEBUG
# text for a terminal, json for Cloud Logging
LOG_FORMAT=text
# every SQL statement SQLAlchemy runs: enormous, so opt in when you need it
SQL_ECHO=false
API_BASE_URL=http://localhost:8000
WEB_BASE_URL=http://localhost:3000
# comma-separated
CORS_ORIGINS=http://localhost:3000

# ================================================================ docker compose (local only)
COMPOSE_PROJECT_NAME=knowhub
# "ollama" also runs Ollama in docker (bootstrap sets this when Ollama isn't running on the host)
COMPOSE_PROFILES=
# Host ports: change any that clash with something already running on your machine
POSTGRES_HOST_PORT=5433
API_HOST_PORT=8000
WEB_HOST_PORT=3000
GCS_HOST_PORT=4443
PUBSUB_HOST_PORT=8085

# ================================================================ database
# superuser password of the local Postgres container
POSTGRES_PASSWORD=postgres
# admin connection: used only to create the role, database and extensions
POSTGRES_ADMIN_URL=postgresql://postgres:postgres@postgres:5432/postgres
# app connection: role, password and database are created from this URL
DATABASE_URL=postgresql+asyncpg://knowhub:knowhub@postgres:5432/knowhub
DB_EXTENSIONS=pg_trgm,vector

# ================================================================ auth
# signs the access-token cookie. bootstrap.sh fills in a random value; on a machine set up
# by hand, generate one with: openssl rand -hex 32
# It must never be blank — the API refuses to start, because tokens cannot be signed.
# Outside local it must also be 32+ random characters.
JWT_SECRET=change-me
ACCESS_TOKEN_TTL_MIN=15
REFRESH_TOKEN_TTL_DAYS=14
# how long a password-reset link stays valid
PASSWORD_RESET_TTL_MIN=30

# ================================================================ gcp
# any id works with the emulators; the real project id on GCP
GCP_PROJECT_ID=knowhub-local
GCP_REGION=us-central1

# ================================================================ storage (GCS)
STORAGE_BACKEND=gcs
# fake-gcs-server inside compose; leave EMPTY on GCP
GCS_ENDPOINT_URL=http://gcs:4443
# how the browser reaches the emulator
GCS_PUBLIC_ENDPOINT_URL=http://localhost:4443
# one bucket, two prefixes (raw/ originals, media/ processed output)
GCS_BUCKET=knowhub-data
GCS_RAW_PREFIX=raw
GCS_MEDIA_PREFIX=media
# origins allowed to upload from the browser (applied on GCP)
GCS_CORS_ORIGINS=http://localhost:3000
GCS_RAW_COLDLINE_AFTER_DAYS=30
SIGNED_URL_TTL_MIN=15
MEDIA_PUBLIC_BASE_URL=http://localhost:4443/knowhub-data/media

# ================================================================ pub/sub
# emulator inside compose; leave EMPTY on GCP
PUBSUB_EMULATOR_HOST=pubsub:8085
PUBSUB_TOPIC_VIDEO_UPLOADED=video-uploaded
PUBSUB_TOPIC_TRANSCODE_EVENTS=transcode-events
PUBSUB_TOPIC_VIDEO_PUBLISHED=video-published
PUBSUB_TOPIC_VIDEO_METADATA_CHANGED=video-metadata-changed
PUBSUB_TOPIC_ANALYTICS_EVENTS=analytics-events
PUBSUB_SUB_MEDIA_UPLOADED=video-uploaded-sub
PUBSUB_SUB_MEDIA_TRANSCODE=transcode-events-sub
PUBSUB_SUB_NOTIFY_PUBLISHED=video-published-sub
PUBSUB_SUB_EMBED_PUBLISHED=video-published-embed-sub
PUBSUB_SUB_EMBED_METADATA=video-metadata-changed-sub
PUBSUB_DEAD_LETTER_MAX_ATTEMPTS=5

# ================================================================ transcoding
# ffmpeg (local worker) | gcp (Transcoder API)
TRANSCODER_BACKEND=ffmpeg
TRANSCODER_LOCATION=us-central1

# ================================================================ analytics
# postgres (local) | bigquery (GCP)
ANALYTICS_BACKEND=postgres
BQ_DATASET=knowhub_analytics
# empty → same as GCP_PROJECT_ID
BQ_PROJECT_ID=
BQ_LOCATION=US
BQ_EVENTS_TABLE=events

# ================================================================ ai
# ollama | vertex | none
# ============================================================== AI (writing assist)
# One switch. Each provider has its own key and its own default model, so switching is
# usually two lines: PROVIDER, and the matching key.
#
#   PROVIDER=openai      OPENAI_API_KEY=sk-...        default MODEL=gpt-4.1-mini
#   PROVIDER=anthropic   ANTHROPIC_API_KEY=sk-ant-... default MODEL=claude-sonnet-5
#   PROVIDER=gemini      GEMINI_API_KEY=AIza...       default MODEL=gemini-2.5-flash
#   PROVIDER=vertex      (no key: uses gcloud ADC)    default MODEL=gemini-2.5-flash
#   PROVIDER=ollama      (no key, runs locally)       default MODEL=llama3.2
#   PROVIDER=none        the writing assist is switched off
PROVIDER=ollama

# Leave empty to use the provider's default model above.
MODEL=

# Leave empty to use the provider's own endpoint — you do NOT need to set this to use
# OpenAI, Anthropic, Gemini or Vertex. Set it only to talk to something OpenAI-compatible
# instead: Ollama, vLLM, LiteLLM, a company proxy.
#   PROVIDER=openai  LLM_API_BASE=http://localhost:11434  MODEL=llama3.2
# (LLM_BASE_URL and OLLAMA_BASE_URL are accepted as the same setting.)
LLM_API_BASE=http://localhost:11434

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# Vertex only: where the models are called; empty uses GCP_REGION ("global" also works).
# It needs the API enabled once per project:
#   gcloud services enable aiplatform.googleapis.com --project <your-project>
# and the account to hold roles/aiplatform.user.
VERTEX_LOCATION=

# Embeddings (semantic search, later). Ollama: nomic-embed-text · Vertex: text-embedding-005
AI_EMBEDDING_MODEL=nomic-embed-text
AI_EMBEDDING_DIM=768
AI_PULL_MODELS=true
AI_ENHANCE_MAX_CHARS=5000

# ================================================================ engagement
# how long after posting a comment can still be edited
COMMENT_EDIT_WINDOW_SECONDS=60

# ================================================================ limits
# 5 GB
MAX_VIDEO_BYTES=5368709120
MAX_VIDEO_SECONDS=7200
MAX_SHORT_SECONDS=60
