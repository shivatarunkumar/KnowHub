{
  "description": "Single-use, short-lived password reset tokens (hash only).",
  "primary_key": [
    "id"
  ],
  "clustering": [
    "token_hash"
  ],
  "schema": [
    {
      "name": "id",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "UUID",
      "defaultValueExpression": "GENERATE_UUID()"
    },
    {
      "name": "user_id",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "→ users.id"
    },
    {
      "name": "token_hash",
      "type": "STRING",
      "mode": "REQUIRED"
    },
    {
      "name": "expires_at",
      "type": "TIMESTAMP",
      "mode": "REQUIRED"
    },
    {
      "name": "used_at",
      "type": "TIMESTAMP",
      "mode": "NULLABLE"
    },
    {
      "name": "requested_ip",
      "type": "STRING",
      "mode": "NULLABLE"
    },
    {
      "name": "user_agent",
      "type": "STRING",
      "mode": "NULLABLE"
    },
    {
      "name": "created_at",
      "type": "TIMESTAMP",
      "mode": "REQUIRED",
      "defaultValueExpression": "CURRENT_TIMESTAMP()"
    }
  ]
}
