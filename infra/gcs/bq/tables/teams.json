{
  "description": "Which part of the organisation a video comes from.",
  "primary_key": [
    "id"
  ],
  "clustering": [
    "slug"
  ],
  "schema": [
    {
      "name": "id",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "UUID",
      "defaultValueExpression": "GENERATE_UUID()"
    },
    {
      "name": "slug",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "unique"
    },
    {
      "name": "name",
      "type": "STRING",
      "mode": "REQUIRED"
    },
    {
      "name": "description",
      "type": "STRING",
      "mode": "NULLABLE"
    },
    {
      "name": "division",
      "type": "STRING",
      "mode": "NULLABLE"
    },
    {
      "name": "sort_order",
      "type": "INT64",
      "mode": "REQUIRED",
      "defaultValueExpression": "0"
    },
    {
      "name": "is_active",
      "type": "BOOL",
      "mode": "REQUIRED",
      "defaultValueExpression": "TRUE"
    },
    {
      "name": "created_at",
      "type": "TIMESTAMP",
      "mode": "REQUIRED",
      "defaultValueExpression": "CURRENT_TIMESTAMP()"
    },
    {
      "name": "updated_at",
      "type": "TIMESTAMP",
      "mode": "REQUIRED",
      "description": "set by the API on every update (Postgres uses a trigger)",
      "defaultValueExpression": "CURRENT_TIMESTAMP()"
    }
  ]
}
