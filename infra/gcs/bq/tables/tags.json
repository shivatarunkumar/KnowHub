{
  "description": "Free-form tags.",
  "primary_key": [
    "id"
  ],
  "clustering": [
    "slug"
  ],
  "schema": [
    {
      "name": "id",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "UUID",
      "defaultValueExpression": "GENERATE_UUID()"
    },
    {
      "name": "slug",
      "type": "STRING",
      "mode": "REQUIRED",
      "description": "unique"
    },
    {
      "name": "name",
      "type": "STRING",
      "mode": "REQUIRED"
    },
    {
      "name": "created_at",
      "type": "TIMESTAMP",
      "mode": "REQUIRED",
      "defaultValueExpression": "CURRENT_TIMESTAMP()"
    }
  ]
}
